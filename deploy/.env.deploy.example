# ─────────────────────────────────────────────────────────────────────────────
# deployment.sh input — copy to `.env.deploy` (gitignored, matches cph/.gitignore's
# `.env.*` pattern) and fill in every value. Never commit the filled-in copy.
#
# Usage:
#   cp cph/deploy/.env.deploy.example cph/deploy/.env.deploy
#   # ...fill in values below (see "Where each value comes from")...
#   set -a; source cph/deploy/.env.deploy; set +a
#   ./cph/deploy/deployment.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── gcloud / deploy targeting ──────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCP_ARTIFACT_REPO=

# ── Cloud Run runtime identity (T-23-18) ───────────────────────────────────
# Dedicated service account deployment.sh grants per-secret access to.
# Create once: see the service-account creation steps in the deploy runbook.
CLOUD_RUN_SERVICE_ACCOUNT=cph-cloudrun-runtime@your-project-id.iam.gserviceaccount.com

# ── Non-secret deploy config (same values as DEPLOYMENT.md's tables) ──────
AIVEN_DB_HOST=
UPSTASH_REDIS_HOST=
DB_USERNAME=
GOOGLE_CLIENT_ID=
R2_ENDPOINT=
MAIL_HOST=
MAIL_USERNAME=
CREDIT_SERVICE_URL=
APP_BASE_URL=

# ── Secret VALUES — only needed the first time each secret is created.     ─
# Same values as your VM's `.env` file, EXCEPT REDIS_PASSWORD (no VM
# equivalent — Upstash is prod-only, get it from the Upstash console after
# provisioning the database, D-14). Once a secret exists in Secret Manager,
# deployment.sh skips it — you can blank these out on every later deploy.
DB_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=
GOOGLE_CLIENT_SECRET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
CREDIT_API_KEY=
MAIL_PASSWORD=
REDIS_PASSWORD=
